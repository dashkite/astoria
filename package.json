{
  "name": "@dashkite/astoria",
  "version": "0.1.0",
  "description": "Models and controllers for Central Park",
  "keywords": [],
  "homepage": "https://github.com/dashkite/astoria#readme",
  "bugs": {
    "url": "https://github.com/dashkite/astoria/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dashkite/astoria.git"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "contributors": [
    "Dan Yoder <dan@dashkite.com>",
    "David Harper <david@dashkite.com>",
    "Chand Rajendra-Nicolucci <chand@dashkite.com>"
  ],
  "exports": {
    ".": {
      "browser": "./build/browser/src/index.js",
      "node": "./build/node/src/index.js"
    },
    "./controllers": {
      "browser": "./build/browser/src/controllers/index.js",
      "node": "./build/node/src/controllers/index.js"
    },
    "./controllers/*": {
      "browser": "./build/browser/src/controllers/*/index.js",
      "node": "./build/node/src/controllers/*/index.js"
    },
    "./mocks/*": {
      "browser": "./build/browser/src/mocks/*/index.js",
      "node": "./build/node/src/mocks/*/index.js"
    },
    "./values": {
      "browser": "./build/browser/src/values/index.js",
      "node": "./build/node/src/values/index.js"
    },
    "./values/*": {
      "browser": "./build/browser/src/values/*/index.js",
      "node": "./build/node/src/values/*/index.js"
    }
  },
  "imports": {
    "#controllers/*": {
      "browser": "./build/browser/src/controllers/*/index.js",
      "node": "./build/node/src/controllers/*/index.js"
    },
    "#fallbacks/*": {
      "browser": "./build/browser/src/controllers/*/fallback.js",
      "node": "./build/node/src/controllers/*/fallback.js"
    },
    "#mocks/*": {
      "browser": "./build/browser/src/mocks/*/index.js",
      "node": "./build/node/src/mocks/*/index.js"
    },
    "#values/*": {
      "browser": "./build/browser/src/values/*/index.js",
      "node": "./build/node/src/values/*/index.js"
    }
  },
  "main": "build/node/src/index.js",
  "files": [
    "build/browser/src",
    "build/node/src"
  ],
  "scripts": {
    "test": "genie test",
    "build": "genie build",
    "release": "genie release"
  },
  "devDependencies": {
    "@dashkite/amen": "^0.9.31",
    "@dashkite/amen-console": "0.4.0",
    "@dashkite/assert": "0.3.0",
    "@dashkite/belmont": "^0.3.29",
    "@dashkite/genie": "0.20.14",
    "@dashkite/genie-clean": "0.9.0",
    "@dashkite/genie-coffee": "0.9.0",
    "@dashkite/genie-module": "^0.5.58",
    "@dashkite/genie-release": "0.5.0",
    "@dashkite/genie-sky": "0.6.42",
    "@dashkite/genie-watch": "0.5.0",
    "@dashkite/genie-yaml": "0.11.13",
    "@dashkite/halstead": "^0.3.29"
  },
  "dependencies": {
    "@dashkite/addison": "link:../addison",
    "@dashkite/domo": "^0.2.35",
    "@dashkite/joy": "0.12.40",
    "@dashkite/lakeshore": "link:../lakeshore",
    "@dashkite/reactive": "^0.7.35",
    "@dashkite/river": "^0.0.10",
    "@dashkite/storage": "0.9.11",
    "js-yaml": "4.1.1",
    "marked": "17.0.6"
  }
}
